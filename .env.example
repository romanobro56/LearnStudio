# Copy to .env and fill in. Never commit .env.

# Required: Gemini reads PDFs, images and YouTube videos, and powers search grounding for the agents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used for worked solutions and grading handwritten work.
GEMINI_VISION_MODEL=gemini-pro-latest

# Optional but recommended: automatic fallback when Gemini is unavailable (reads text and images, not PDFs/video).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional tuning
PORT=5174
AI_CONCURRENCY=6
DEEPSEEK_CONCURRENCY=12
# Set to 0 to stop the server from resuming interrupted imports on startup.
RESUME=1

# Present in the original key bundle but not used by the code yet.
TYPESAFE_API_KEY=
JEV_MODEL=
